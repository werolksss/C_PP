string line(string prompt) {
    cout << prompt;
    string s;
    if (!getline(cin, s)) throw runtime_error("Ввод завершён.");
    return s;
}
template<class T> T read(string prompt) {
    istringstream s(line(prompt));
    T x; string extra;
    if (!(s >> x) || (s >> extra)) throw runtime_error("Неверный ввод.");
    return x;
}
vector<int> randomArray(int n, int low = -30, int high = 30) {
    vector<int> a(n);
    for (int& x : a) x = uniform_int_distribution<int>(low, high)(gen);
    return a;
}
void print(const vector<int>& a) {
    for (int x : a) cout << x << ' ';
    cout << '\n';
}
char32_t lower(char32_t c) {
    if ((c >= U'A' && c <= U'Z') || (c >= U'А' && c <= U'Я')) return c + 32;
    return c == U'Ё' ? U'ё' : c;
}
char32_t upper(char32_t c) {
    if ((c >= U'a' && c <= U'z') || (c >= U'а' && c <= U'я')) return c - 32;
    return c == U'ё' ? U'Ё' : c;
}

struct Date { int d, m, y; };
bool leap(int y) { return y % 400 == 0 || (y % 4 == 0 && y % 100 != 0); }
int days(int m, int y) {
    int a[] = {31,28,31,30,31,30,31,31,30,31,30,31};
    return a[m - 1] + (m == 2 && leap(y));
}
int serial(Date t) {
    int y = t.y - 1, n = 365*y + y/4 - y/100 + y/400 + t.d - 1;
    for (int m = 1; m < t.m; ++m) n += days(m, t.y);
    return n;
}
Date today() {
    time_t now = time(nullptr);
    tm t = *localtime(&now);
    return {t.tm_mday, t.tm_mon + 1, t.tm_year + 1900};
}
Date birthday(Date b, int y) {
    b.y = y;
    b.d = min(b.d, days(b.m, y));
    return b;
}
Date next(Date t) {
    if (++t.d > days(t.m, t.y)) {
        t.d = 1;
        if (++t.m > 12) { t.m = 1; ++t.y; }
    }
    return t;
}
string dateText(Date t) {
    ostringstream s;
    s << setfill('0') << setw(4) << t.y << '-'
      << setw(2) << t.m << '-' << setw(2) << t.d;
    return s.str();
}

void task1() {
    istringstream s(line("Три числа: "));
    double a, b, c; string extra;
    if (!(s >> a >> b >> c) || (s >> extra) ||
        !isfinite(a) || !isfinite(b) || !isfinite(c))
        throw runtime_error("Введите три конечных числа.");

    double product = 1; int n = 0;
    // По примеру задания учитываются только положительные числа.
    for (double x : {a,b,c}) if (x > 0) { product *= x; ++n; }
    cout << "Среднее арифметическое: " << (a+b+c)/3 << '\n';
    if (n) cout << "Среднее геометрическое положительных: "
                << (n == 2 ? sqrt(product) : pow(product, 1.0/n)) << '\n';
    else cout << "Положительных чисел нет.\n";
    cout << "Максимальное по модулю: " << max({fabs(a),fabs(b),fabs(c)}) << '\n';
}

