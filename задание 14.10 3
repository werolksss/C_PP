void task3() {
    Date b, t = today();
    istringstream s(line("Дата рождения: день месяц год: "));
    string extra;
    if (!(s >> b.d >> b.m >> b.y) || (s >> extra) ||
        b.y < 1 || b.y > 9999 || b.m < 1 || b.m > 12 ||
        b.d < 1 || b.d > days(b.m,b.y) || serial(b) > serial(t))
        throw runtime_error("Некорректная дата.");

    string names[] = {"понедельник","вторник","среда","четверг",
                      "пятница","суббота","воскресенье"};
    Date n = birthday(b,t.y);
    int age = t.y-b.y-(serial(t)<serial(n));
    if (serial(n)<serial(t)) n = birthday(b,t.y+1);

    cout << "Сегодня: " << dateText(t)
         << "\nДень рождения: " << names[serial(b)%7]
         << "\nПолных лет: " << age
         << "\nДней до ДР: " << serial(n)-serial(t) << '\n';
}

void task4() {
    istringstream s(line("Введите 10–20 оценок от 2 до 5: "));
    vector<int> a; map<int,int> f; int x;
    while (s >> x) {
        if (x<2 || x>5) throw runtime_error("Оценки должны быть от 2 до 5.");
        a.push_back(x); ++f[x];
    }
    int n = a.size();
    if (!s.eof() || n<10 || n>20) throw runtime_error("Нужно 10–20 оценок.");

    double mean = accumulate(a.begin(),a.end(),0.0)/n, variance = 0;
    int frequency = 0, mode = a[0];
    for (auto [value,count] : f) frequency = max(frequency,count);
    for (int value : a) if (f[value]==frequency) { mode=value; break; }
    for (int value : a) variance += pow(value-mean,2);
    sort(a.begin(),a.end());

    cout << "Среднее: " << mean
         << "\nМедиана: " << (a[(n-1)/2]+a[n/2])/2.0
         << "\nМода: " << mode << "\nВсе моды: ";
    for (auto [value,count] : f) if (count==frequency) cout << value << ' ';
    cout << "\nСтандартное отклонение: " << sqrt(variance/(n-1)) << '\n';
}

