void task6() {
    auto s = utf.from_bytes(line("Строка: "));
    auto sub = utf.from_bytes(line("Подстрока: "));
    auto u = s, r = s;
    transform(u.begin(),u.end(),u.begin(),upper);
    cout << "Длина: " << s.size() << "\nВерхний регистр: " << utf.to_bytes(u) << '\n';
    auto p = s.find(sub);
    if (p==u32string::npos) cout << "Подстрока не найдена.\n";
    else cout << "Позиция с 1: " << p+1 << '\n';
    replace(r.begin(),r.end(),U'а',U'*');
    cout << "Замена: " << utf.to_bytes(r) << '\n';
    reverse(s.begin(),s.end());
    cout << "Наоборот: " << utf.to_bytes(s) << '\n';
}

void task7() {
    auto s = utf.from_bytes(line("Текст: ")) + U" ";
    map<u32string,int> f; u32string word;
    for (auto c : s) {
        c = lower(c);
        if ((c>=U'a' && c<=U'z') || (c>=U'а' && c<=U'я') || c==U'ё')
            word += c;
        else if (!word.empty()) { ++f[word]; word.clear(); }
    }
    cout << "Частоты:\n";
    for (auto [w,n] : f) cout << utf.to_bytes(w) << ": " << n << '\n';
    cout << "Уникальные по алфавиту:\n";
    for (auto [w,n] : f) cout << utf.to_bytes(w) << '\n';
    vector<pair<u32string,int>> top(f.begin(),f.end());
    sort(top.begin(),top.end(),[](auto a,auto b){
        return a.second!=b.second ? a.second>b.second : a.first<b.first;
    });
    cout << "Три самых частых:\n";
    for (size_t i=0; i<min(size_t(3),top.size()); ++i)
        cout << utf.to_bytes(top[i].first) << ": " << top[i].second << '\n';
}

struct Student { string name, group; double score; };
void save(string path, const vector<Student>& a) {
    ofstream f(path);
    for (auto s : a)
        f << quoted(s.name) << ' ' << quoted(s.group) << ' '
          << setprecision(17) << s.score << '\n';
    if (!f) throw runtime_error("Ошибка записи файла.");
}

void task8() {
    int n = read<int>("Количество студентов: ");
    if (n<=0) throw runtime_error("Количество должно быть положительным.");
    vector<Student> a, filtered;
    for (int i=0; i<n; ++i) {
        Student s{line("ФИО: "),line("Группа: "),read<double>("Средний балл: ")};
        if (s.name.empty() || s.group.empty() || !isfinite(s.score) ||
            s.score<2 || s.score>5) throw runtime_error("Неверные данные.");
        a.push_back(s);
    }
    save("students.txt",a);
    a.clear();
    ifstream f("students.txt"); Student s;
    while (f >> quoted(s.name) >> quoted(s.group) >> s.score) a.push_back(s);
    if (a.size()!=size_t(n)) throw runtime_error("Ошибка чтения файла.");

    cout << "Прочитано:\n";
    for (auto s : a) {
        cout << s.name << " | " << s.group << " | " << s.score << '\n';
        if (s.score>4.5) filtered.push_back(s);
    }
    auto best = max_element(a.begin(),a.end(),[](auto x,auto y){return x.score<y.score;});
    cout << "Максимальный балл: " << best->name << " — " << best->score
         << "\nБалл выше 4.5:\n";
    for (auto s : filtered) cout << s.name << " | " << s.group << " | " << s.score << '\n';
    save("students_filtered.txt",filtered);
}

void task9() {
    auto a = randomArray(7,-20,35);
    vector<string> dates; Date d = today();
    for (int i=0; i<7; ++i) { dates.push_back(dateText(d)); d=next(d); }
    int low = *min_element(a.begin(),a.end()), high = *max_element(a.begin(),a.end());
    double mean = accumulate(a.begin(),a.end(),0.0)/7;
    ofstream f("weather.json");
    f << "{\"days\":[";
    cout << "Гистограмма: # = 1 градус, | = ноль.\n";
    for (int i=0; i<7; ++i) {
        cout << dates[i] << ' ' << setw(3) << a[i] << ' '
             << string(20-max(0,-a[i]),' ') << string(max(0,-a[i]),'#')
             << '|' << string(max(0,a[i]),'#') << '\n';
        f << (i ? "," : "") << "{\"date\":\"" << dates[i]
          << "\",\"temperature\":" << a[i] << '}';
    }
    cout << "Средняя: " << mean << "\nМинимум: " << low << "\nМаксимум: " << high << '\n';
    f << "],\"average\":" << setprecision(17) << mean
      << ",\"minimum\":" << low << ",\"maximum\":" << high;
    for (int value : {low,high}) {
        cout << (value==low ? "Самые холодные: " : "Самые тёплые: ");
        f << (value==low ? ",\"coldest_days\":[" : ",\"warmest_days\":[");
        bool first = true;
        for (int i=0; i<7; ++i) if (a[i]==value) {
            cout << dates[i] << ' ';
            f << (first ? "" : ",") << '"' << dates[i] << '"';
            first = false;
        }
        cout << '\n'; f << ']';
    }
    f << '}';
    if (!f) throw runtime_error("Ошибка записи weather.json.");
}

